FROM node:4.4.7
MAINTAINER Nitrous.IO <eng@nitrous.io>

# Install essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
  apparmor \
  build-essential \
  ca-certificates \
  curl \
  git-core \
  mercurial \
  libpq-dev \
  nodejs \
  python-pip \
  wget

# Install s3cmd
RUN cd /tmp && wget https://github.com/s3tools/s3cmd/releases/download/v1.6.1/s3cmd-1.6.1.tar.gz && \
  tar xzvf s3cmd-1.6.1.tar.gz && cd /tmp/s3cmd-1.6.1 && \
  python setup.py install && rm -rf /tmp/s3cmd-1.6.1*

# Install go 1.6
RUN \
  mkdir -p /usr/local/opt && \
  mkdir -p /tmp/go-1.6 && \
  curl -s https://storage.googleapis.com/golang/go1.6.linux-amd64.tar.gz | tar -xvz -C /tmp/go-1.6 && \
  mv /tmp/go-1.6/go /usr/local/go-1.6 && \
  cd /usr/local && \
  ln -s go-1.6 go

ENV GOPATH /opt
ENV GOBIN /opt/bin
ENV PATH /usr/local/go/bin:/opt/bin:$PATH
ENV GOROOT /usr/local/go

RUN go get -u github.com/kardianos/govendor
RUN go get -u github.com/onsi/ginkgo/ginkgo
RUN go get -u github.com/onsi/gomega

RUN npm install -g webpack

# Cache node modules
RUN mkdir -p /tmp/cache_node_modules
ADD package.json /tmp/cache_node_modules/

RUN cd /tmp/cache_node_modules && npm install --quiet

RUN mkdir -p /opt/src/github.com/nitrous-io/nitrous-solo

ADD . /opt/src/github.com/nitrous-io/nitrous-solo

RUN mv /tmp/cache_node_modules/node_modules /opt/src/github.com/nitrous-io/nitrous-solo/node_modules
RUN cd /opt/src/github.com/nitrous-io/nitrous-solo && npm i
