#!/bin/bash -e

IMAGE_NAME=nitrous-solo-build

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $DIR/..

# Ensure we have the latest image
docker build -t $IMAGE_NAME -f Dockerfile.build .

docker run --rm \
  -e UPLOAD_S3=$UPLOAD_S3 \
  -e ACCESS_KEY=$ACCESS_KEY \
  -e SECRET_KEY=$SECRET_KEY \
  -e PUBLIC_BUCKET=$PUBLIC_BUCKET \
  -e NITROUS_ENV=$NITROUS_ENV \
  $IMAGE_NAME /opt/src/github.com/nitrous-io/nitrous-solo/script/build-deb
